# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used to build OAuth redirect targets (server-only). Required
# in production/behind a reverse proxy (Coolify/Traefik), where the request's
# own origin can resolve to the container's internal address instead of the
# public domain. e.g. https://dashbee.example.com (no trailing slash).
SITE_URL=

# Google OAuth (configured as a provider in Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheets sync (service account with the sheet shared to its email)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
